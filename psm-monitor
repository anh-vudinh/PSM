#!/usr/bin/env bash

set -u

SOURCE="${BASH_SOURCE[0]}"

while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"

    if [[ "$SOURCE" != /* ]]; then
        SOURCE="$DIR/$SOURCE"
    fi
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

MONITOR_JS="$SCRIPT_DIR/scripts/resource-monitor.js"
PID_FILE="$SCRIPT_DIR/resource-monitor.pid"

is_running() {
    if [[ ! -f "$PID_FILE" ]]; then
        return 1
    fi

    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"

    if [[ -z "$pid" ]]; then
        rm -f "$PID_FILE"
        return 1
    fi

    if kill -0 "$pid" 2>/dev/null; then
        return 0
    fi

    rm -f "$PID_FILE"
    return 1
}

start_monitor() {
    if [[ ! -f "$MONITOR_JS" ]]; then
        echo "ERROR: resource-monitor.js was not found:"
        echo "  $MONITOR_JS"
        exit 1
    fi

    if is_running; then
        echo "Resource monitor is already running."
        echo "PID: $(cat "$PID_FILE")"
        return 0
    fi

    rm -f "$PID_FILE"

    node "$MONITOR_JS" &
    local pid=$!

    echo "$pid" > "$PID_FILE"

    cleanup() {
        trap - INT TERM TSTP

        if kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null || true
        fi

        rm -f "$PID_FILE"

        wait "$pid" 2>/dev/null || true

        exit 0
    }

    trap cleanup INT TERM TSTP

    wait "$pid"

    rm -f "$PID_FILE"
}

stop_monitor() {
    if [[ ! -f "$PID_FILE" ]]; then
        echo "Resource monitor is not running."
        return 0
    fi

    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true

        for _ in {1..20}; do
            if ! kill -0 "$pid" 2>/dev/null; then
                break
            fi

            sleep 0.1
        done

        if kill -0 "$pid" 2>/dev/null; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi

    rm -f "$PID_FILE"

    echo "Resource monitor stopped."
}

status() {
    if is_running; then
        echo "Resource monitor is RUNNING."
        echo "PID: $(cat "$PID_FILE")"
    else
        echo "Resource monitor is NOT running."
    fi
}

usage() {
    echo "PSM Resource Monitor"
    echo
    echo "Usage:"
    echo "  psm-monitor"
    echo "  psm-monitor on"
    echo "  psm-monitor off"
    echo "  psm-monitor status"
    echo
    echo "Commands:"
    echo "  on         Start live resource monitor"
    echo "  off        Stop live resource monitor"
    echo "  status     Show monitor status"
}

case "${1:-on}" in
    on|start)
        start_monitor
        ;;

    off|stop)
        stop_monitor
        ;;

    status)
        status
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        echo "Unknown command: $1"
        echo
        usage
        exit 1
        ;;
esac